generator client {
  provider = "prisma-client-js"
  // The CI pipeline builds on Ubuntu and uploads a prebuilt bundle to Vercel,
  // whose Node runtime identifies as rhel-openssl-3.0.x. Ship that engine too,
  // or the deployed app fails at runtime with "Query Engine not found".
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Provider-agnostic by design: any standard PostgreSQL works (Neon, RDS,
  // Supabose, self-hosted) — DATABASE_URL is the only required DB config.
  // If a provider ever needs a separate non-pooled migration URL, re-add:
  //   directUrl = env("DIRECT_URL")
}

// Single flat table per the assignment brief: 400-row read-only dataset,
// normalization would add complexity with no benefit at this scale.
model Order {
  order_id          String    @id // unique, kept as text
  client_id         String
  order_date        DateTime  @db.Date // authoritative date for order-time analysis
  delivery_date     DateTime? @db.Date // nullable: 30 rows have no delivery date
  carrier           String
  origin_city       String
  destination_city  String
  status            String // delivered | delayed | in_transit | exception | canceled
  sku               String
  product_category  String
  quantity          Int
  unit_price_usd    Decimal   @db.Decimal(10, 2)
  order_value_usd   Decimal   @db.Decimal(12, 2)
  is_promo          Boolean
  promo_discount_pct Decimal  @db.Decimal(5, 2)
  region            String
  warehouse         String

  // Indexes designed for the hot query patterns (see README):
  //  - (order_date, status): dashboard KPIs + time series -> index-only scan
  //  - (carrier): breakdown filters (bitmap-ANDed with the date index)
  //  - (product_category, order_date) / (sku, order_date): forecast history per entity
  @@index([order_date, status])
  @@index([carrier])
  @@index([product_category, order_date])
  @@index([sku, order_date])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String    @default("!") // "!" = invited, not yet activated
  roleId         String?
  roleRef        Role?     @relation(fields: [roleId], references: [id])
  status         String    @default("active") // active | disabled
  inviteToken    String?   @unique
  inviteExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  conversations  Conversation[]
  reports        Report[]
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // stable identifier ("admin", "analyst", or a slug)
  name        String // display name
  description String?
  /// JSON array of permission keys — see PERMISSION_KEYS in src/lib/auth.ts
  permissions String
  isSystem    Boolean  @default(false) // built-in roles cannot be deleted
  createdAt   DateTime @default(now())
  users       User[]
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]

  // list query: WHERE userId ORDER BY updatedAt DESC
  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  /// Full structured AI result (tool runs, analytics/chart, forecast) for re-rendering history
  resultJson     String?
  createdAt      DateTime     @default(now())

  // history query: WHERE conversationId ORDER BY createdAt ASC
  @@index([conversationId, createdAt])
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Validated AnalyticsQuery JSON (metric, dimension, timeBucket, dateRange, filters, sort, limit)
  queryJson String
  /// Canonical query identity (ignores paging/limit) — lets AI generation reuse
  /// an existing report instead of saving the same data twice.
  queryKey  String?
  /// "auto" (server-selected chart type) | bar | line | pie
  chartType String   @default("auto")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One report per name per user: saving under an existing name updates it.
  @@unique([userId, name])
  // Library list: WHERE userId [AND name LIKE q] ORDER BY updatedAt DESC
  @@index([userId, updatedAt])
}
