# PostgreSQL connection — provider-agnostic (Neon, RDS, Supabase, self-hosted).
# This is the only required DB variable. Include sslmode as your provider needs.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# AI provider: "anthropic" (default — GLM via its Anthropic-compatible endpoint,
# or Claude direct) or "openai_compatible" (OpenAI, GLM v4 endpoint, etc.).
AI_PROVIDER="anthropic"
AI_MODEL="glm-4.6"
AI_API_KEY=""

# Base URL. Default provider (GLM via z.ai, Anthropic protocol):
AI_BASE_URL="https://api.z.ai/api/anthropic"
# For Claude direct, omit AI_BASE_URL (or unset it).
# For the OpenAI-compatible provider instead:
#   AI_PROVIDER="openai_compatible"
#   AI_BASE_URL="https://api.z.ai/api/paas/v4"   # GLM (OpenAI protocol)
#   AI_BASE_URL="https://api.openai.com/v1"       # OpenAI (model e.g. gpt-4o-mini)

# Optional: max concurrent AI turns per server instance (default 3)
AI_MAX_CONCURRENCY=""

# JWT signing secret for auth sessions (generate: openssl rand -hex 32)
AUTH_SECRET=""

# Optional SMTP for sending user-invite emails (if unset, invite links are
# shown in the admin UI instead of being emailed)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
